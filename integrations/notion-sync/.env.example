# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
#
# NOTION_TOKEN:   your integration's token (ntn_...)
# NOTION_DB_TECH: database ID for the "tech" category (32 hex chars, with or without hyphens)
# NOTION_DB_NOTES: database ID for the "notes" category

NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_TECH=00000000000000000000000000000000
NOTION_DB_NOTES=00000000000000000000000000000000
